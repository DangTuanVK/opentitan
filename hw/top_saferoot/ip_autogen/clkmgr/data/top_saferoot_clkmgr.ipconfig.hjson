{
  instance_name: top_saferoot_clkmgr
  param_values:
  {
    src_clks:
    {
      main:
      {
        name: main
        aon: false
        freq: 50000000
        ref: false
      }
      io:
      {
        name: io
        aon: false
        freq: 50000000
        ref: false
      }
      aon:
      {
        name: aon
        aon: true
        freq: 200000
        ref: true
      }
    }
    derived_clks:
    {
      io_div2:
      {
        name: io_div2
        aon: false
        freq: 25000000
        ref: false
        div: 2
        src:
        {
          name: io
          aon: no
          freq: "50000000"
          ref: false
        }
      }
      io_div4:
      {
        name: io_div4
        aon: false
        freq: 12500000
        ref: false
        div: 4
        src:
        {
          name: io
          aon: no
          freq: "50000000"
          ref: false
        }
      }
    }
    typed_clocks:
    {
      ast_clks:
      {
        clk_main_i:
        {
          src_name: main
          endpoint_ip: clkmgr_aon
        }
        clk_io_i:
        {
          src_name: io
          endpoint_ip: clkmgr_aon
        }
        clk_aon_i:
        {
          src_name: aon
          endpoint_ip: clkmgr_aon
        }
      }
      ft_clks:
      {
        clk_io_div4_powerup:
        {
          src_name: io_div4
          endpoint_ip: pwrmgr_aon
        }
        clk_aon_powerup:
        {
          src_name: aon
          endpoint_ip: pwrmgr_aon
        }
        clk_main_powerup:
        {
          src_name: main
          endpoint_ip: rstmgr_aon
        }
        clk_io_powerup:
        {
          src_name: io
          endpoint_ip: rstmgr_aon
        }
        clk_io_div2_powerup:
        {
          src_name: io_div2
          endpoint_ip: rstmgr_aon
        }
        clk_aon_secure:
        {
          src_name: aon
          endpoint_ip: sensor_ctrl
        }
        clk_aon_timers:
        {
          src_name: aon
          endpoint_ip: aon_timer_aon
        }
      }
      rg_clks:
      {
        clk_main_infra:
        {
          src_name: main
          endpoint_ip: rom_ctrl
        }
        clk_io_div4_infra:
        {
          src_name: io_div4
          endpoint_ip: sram_ctrl
        }
        clk_main_secure:
        {
          src_name: main
          endpoint_ip: csrng
        }
        clk_io_div4_secure:
        {
          src_name: io_div4
          endpoint_ip: otbn
        }
        clk_io_div4_timers:
        {
          src_name: io_div4
          endpoint_ip: rv_timer
        }
      }
      sw_clks:
      {
        clk_io_div4_peri:
        {
          src_name: io_div4
          endpoint_ip: spi_device
        }
        clk_io_div2_peri:
        {
          src_name: io_div2
          endpoint_ip: spi_device
        }
      }
      hint_clks:
      {
        clk_main_aes:
        {
          src_name: main
          endpoint_ip: aes
        }
        clk_main_hmac:
        {
          src_name: main
          endpoint_ip: hmac
        }
        clk_main_kmac:
        {
          src_name: main
          endpoint_ip: kmac
        }
        clk_main_otbn:
        {
          src_name: main
          endpoint_ip: otbn
        }
      }
    }
    hint_names:
    {
      clk_main_aes: HintMainAes
      clk_main_hmac: HintMainHmac
      clk_main_kmac: HintMainKmac
      clk_main_otbn: HintMainOtbn
    }
    parent_child_clks:
    {
      main:
      [
        main
      ]
      io:
      [
        io
        io_div2
        io_div4
      ]
    }
    exported_clks: {}
    number_of_clock_groups: 7
    with_alert_handler: true
    topname: saferoot
    uniquified_modules: {}
    ext_clk_bypass: true
    module_instance_name: clkmgr
  }
}
