name: "lowrisc:systems:top_saferoot_ast_pkg"
description: "SafeRoot AST wrapper package (NumAlerts=11, matches SafeRoot sensor_ctrl)"
virtual:
  - lowrisc:systems:ast_pkg

filesets:
  files_rtl:
    depend:
      - lowrisc:darjeeling_constants:top_pkg
      - lowrisc:ip:lc_ctrl_pkg
    files:
      - rtl/ast_pkg.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
