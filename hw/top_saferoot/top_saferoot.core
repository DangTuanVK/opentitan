name: "lowrisc:systems:top_saferoot:0.1"
description: "Technology-independent SafeRoot toplevel"
filesets:
  files_rtl_generic:
    depend:
      # Autogen packages first
      - lowrisc:saferoot_constants:top_racl_pkg
      - lowrisc:saferoot_ip:alert_handler_reg
      - lowrisc:saferoot_ip:otp_ctrl_macro_pkg
      - lowrisc:saferoot_ip:otp_ctrl_top_specific_pkg
      - lowrisc:saferoot_ip:pwrmgr_pkg
      # Core IPs
      - lowrisc:ip:uart:0.1
      - lowrisc:ip:rv_timer
      - lowrisc:ip:tlul
      - lowrisc:systems:top_saferoot_ast_pkg  # SafeRoot ast_pkg (NumAlerts=11, virtual ast_pkg)
      - lowrisc:ip:spi_device
      - lowrisc:ip:i2c
      - lowrisc:ip:aes
      - lowrisc:ip:entropy_src
      - lowrisc:ip:csrng
      - lowrisc:ip:edn
      - lowrisc:ip:hmac
      - lowrisc:ip:kmac
      - lowrisc:ip:otbn
      - lowrisc:prim:ram_1p_scr
      - lowrisc:prim:flash
      - lowrisc:ip:sram_ctrl
      - lowrisc:ip:keymgr
      - lowrisc:ip:lc_ctrl
      - lowrisc:ip:rom_ctrl
      - lowrisc:ip:aon_timer
      # SafeRoot-specific autogen IPs
      - lowrisc:top_saferoot:xbar_main
      - lowrisc:saferoot_ip:alert_handler
      - lowrisc:saferoot_ip:clkmgr
      - lowrisc:saferoot_ip:flash_ctrl
      - lowrisc:saferoot_ip:gpio
      - lowrisc:saferoot_ip:otp_ctrl
      - lowrisc:saferoot_ip:pinmux
      - lowrisc:saferoot_ip:pwrmgr
      - lowrisc:saferoot_ip:rstmgr
      - lowrisc:saferoot_ip:rv_plic
      - lowrisc:saferoot_ip:rv_core_ibex
      # Sensor ctrl (from Earl Grey — shared)
      # - lowrisc:systems:top_earlgrey_sensor_ctrl  # DISABLED: conflicts with SafeRoot racl_pkg
      - lowrisc:saferoot_ip:sensor_ctrl:0.1
      # Platform packages
      - lowrisc:constants:top_saferoot_jtag_id_pkg
      - lowrisc:constants:top_saferoot_ibex_pmp_reset_pkg
      - lowrisc:saferoot_constants:top_pkg
      - lowrisc:tlul:headers
      - lowrisc:prim:all
      - lowrisc:prim:mubi
      - lowrisc:systems:top_saferoot_pkg
      - "!fileset_partner ? (lowrisc:ip:otp_macro)"
    files:
      - rtl/autogen/top_saferoot.sv
    file_type: systemVerilogSource

  files_rtl_testing:
    depend:
      - lowrisc:saferoot_constants:testing_rnd_cnst_pkg
      - lowrisc:saferoot_constants:testing_lc_ctrl_token_pkg

targets:
  default:
    filesets:
      - files_rtl_generic
      - files_rtl_testing
