# SafeRoot AES NIST Test — Makefile
# Produces: test_aes.vmem for Verilator simulation

CROSS   = riscv32-unknown-elf-
CC      = $(CROSS)gcc
OBJCOPY = $(CROSS)objcopy
OBJDUMP = $(CROSS)objdump
SIZE    = riscv64-unknown-elf-size

CFLAGS  = -march=rv32imc -mabi=ilp32 -Os -Wall -Wextra \
          -ffunction-sections -fdata-sections -nostdlib -nostartfiles \
          -ffreestanding -fno-builtin -I../hal
LDFLAGS = -T ../rom/rom.ld -nostdlib -Wl,--gc-sections -Wl,-Map=test_aes.map

TARGET  = test_aes

all: $(TARGET).vmem

$(TARGET).elf: ../rom/start.S test_aes_nist.c ../rom/util.c ../hal/uart_drv.c ../hal/aes_drv.c
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^
	$(SIZE) $@

$(TARGET).bin: $(TARGET).elf
	$(OBJCOPY) -O binary $< $@

$(TARGET).vmem: $(TARGET).bin
	od -An -tx4 -v -w4 $< | sed 's/^ *//' > $@
	@echo "AES test image: $@ ($$(wc -l < $@) words, $$(wc -c < $(TARGET).bin) bytes)"

$(TARGET).dis: $(TARGET).elf
	$(OBJDUMP) -d -t $< > $@

clean:
	rm -f $(TARGET).elf $(TARGET).bin $(TARGET).vmem $(TARGET).dis $(TARGET).map

.PHONY: all clean
